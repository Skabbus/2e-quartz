views:
  - type: table
    name: Tabell
    filters:
      and:
        - type == ["Non-Weapon Proficiency"]
        - duplicate != true
    order:
      - file.name
      - duplicate
      - file.path
      - class_group
      - type
      - subclass
      - race_allowed
    sort: []
    columnSize:
      file.name: 152
      note.duplicate: 15
      file.path: 1055
