views:
  - type: table
    name: Bolestus
    filters:
      or:
        - and:
            - spellist.contains("Priest")
            - sphere.containsAny("Necromantic", "Time", "All")
            - level != 0
        - and:
            - spellist.contains("Priest")
            - sphere.containsAny("Elemental", "Weather", "Plant")
            - level != 0
            - level <= 3
    order:
      - file.name
      - level
      - school
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 358
