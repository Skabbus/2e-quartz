views:
  - type: table
    name: NWPs
    filters:
      and:
        - type.contains("NWP")
        - duplicate != true
        - disabled != true
        - "!class_group.isEmpty()"
    order:
      - file.name
      - class_group
      - file.folder
      - ability
      - check_modifier
    sort: []
    columnSize:
      note.check_modifier: 131
  - type: table
    name: Disabled NWPs
    filters:
      and:
        - type.contains("NWP")
        - duplicate != true
        - disabled == true
    order:
      - file.name
      - class_group
      - ability
      - check_modifier
      - file.path
    columnSize:
      note.check_modifier: 53
  - type: table
    name: Duplicate NWPs
    filters:
      and:
        - type.contains("NWP")
        - duplicate == true
    order:
      - file.name
      - class_group
      - ability
      - check_modifier
    sort:
      - property: ability
        direction: ASC
