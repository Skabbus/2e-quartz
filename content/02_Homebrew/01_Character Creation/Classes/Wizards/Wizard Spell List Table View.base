views:
  - type: table
    name: By Level
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - level > 0
    order:
      - file.name
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 223
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Evocation
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Invocation", "Evocation", "Invocation/Evocation")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Conjuration
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Conjuration", "Conjuration/Summoning")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Illusion
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Illusion", "Illusion/Phantasm", "Divination/Illusion")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Divination
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Divination", "Divination/Illusion", "Divination/Necromancy")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Necromancy
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Necromancy", "Necromancy/Alteration")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Abjuration
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.contains("Abjuration")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Alteration
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Alteration", "Necromancy/Alteration")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Enchantment
    filters:
      or:
        - and:
            - spellist.contains("Wizard")
            - school.containsAny("Enchantment", "Enchantment/Charm")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
  - type: table
    name: Other
    filters:
      and:
        - or:
            - school == ["Dimension"]
            - school == ["All Schools"]
        - spellist.contains("Wizard")
    order:
      - file.name
      - school
      - level
    sort:
      - property: level
        direction: ASC
    columnSize:
      file.name: 555
      note.level: 78
    columnWidth: 200
    imageAspectRatio: 0.5
