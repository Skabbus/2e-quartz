views:
  - type: table
    name: Tabell
    filters:
      and:
        - type == ["Non-Weapon Proficiency"]
        - disabled == true
    order:
      - file.name
      - sphere
      - level
      - file.folder
    sort:
      - property: level
        direction: ASC
      - property: file.path
        direction: ASC
    columnSize:
      file.name: 555
      note.sphere: 225
      note.level: 54
